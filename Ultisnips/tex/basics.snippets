# Include this code block at the top of a *.snippets file...
# It relies on vimtex to have this special function that tells Ultisnip when we're in math mode of a latex document
# Important behavior is that $Visual either in visual mode or not
# ----------------------------- #
global !p
def math():
  return vim.eval('vimtex#syntax#in_mathzone()') == '1'
endglobal
# ----------------------------- #
snippet meta "metacognitive questions"
\begin{itemize}
	\item What exactly are you doing? (Can you describe it precisely?)
	\item Why are you doing it?
	\item How does it help you? (What will you do with the outcome once you obtain it?)
\end{itemize}
$0
endsnippet


