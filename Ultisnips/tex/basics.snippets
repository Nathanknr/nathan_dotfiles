endsnippet

############################################
# Core Analysis + Calculus Theorems
############################################

context "math()"

snippet "limdef" "ε-δ definition of limit"
\lim_{x \to a} f(x) = L
\quad \forall \varepsilon > 0, \exists \delta > 0 \text{ such that }
0 < |x - a| < \delta \Rightarrow |f(x) - L| < \varepsilon
endsnippet

snippet "cont" "continuity definition"
f \text{ is continuous at } a \iff \lim_{x \to a} f(x) = f(a)
endsnippet

snippet "mvt" "Mean Value Theorem"
\exists c \in (a,b) \text{ such that }
f'(c) = \frac{f(b) - f(a)}{b - a}
endsnippet

snippet "ftc1" "Fundamental Theorem of Calculus I"
\frac{d}{dx} \int_a^x f(t)\,dt = f(x)
endsnippet

snippet "ftc2" "Fundamental Theorem of Calculus II"
\int_a^b f(x)\,dx = F(b) - F(a), \quad F' = f
endsnippet


############################################
# Vector Calculus Theorems
############################################

snippet "green" "Green's Theorem"
\oint_C (P\,dx + Q\,dy)
=
\iint_D \left(\frac{\partial Q}{\partial x} - \frac{\partial P}{\partial y}\right)\,dA
endsnippet

snippet "stokes" "Stokes' Theorem"
\int_{\partial S} \mathbf{F} \cdot d\mathbf{r}
=
\iint_S (\nabla \times \mathbf{F}) \cdot \mathbf{n}\, dS
endsnippet


############################################
# Series + Inequalities
############################################

snippet "taylor" "Taylor expansion"
f(x) = f(a) + f'(a)(x-a) + \frac{f''(a)}{2!}(x-a)^2 + \cdots
endsnippet

snippet "cs" "Cauchy-Schwarz inequality"
|\langle x, y \rangle| \le \|x\|\|y\|
endsnippet

snippet "triineq" "Triangle inequality"
\|x + y\| \le \|x\| + \|y\|
endsnippet

snippet ddd "The three dots in latex" A 
\vdots
endsnippet

