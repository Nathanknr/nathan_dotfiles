set mbox_type = Maildir
set mail_check = 60
set edit_headers = yes
set include
set sidebar_visible = yes
set editor = "nvim"
set sort = 'reverse-date'
set mailcap_path = "/home/nathan/.config/neomutt/mailcap"

set mail_check_stats
auto_view text/html
alternative_order text/html text/plain 

# Load Personal account by default
source ~/.config/neomutt/gmail.muttrc

named-mailboxes "Personal Inbox" "/home/nathan/.mail/gmail/Inbox"
named-mailboxes "Sent P"          "/home/nathan/.mail/gmail/[Gmail]/Sent Mail"
named-mailboxes "Drafts P"        "/home/nathan/.mail/gmail/[Gmail]/Drafts"
named-mailboxes "Trash P"         "/home/nathan/.mail/gmail/[Gmail]/Trash"


named-mailboxes "School Inbox" "/home/nathan/.mail/school/Inbox"
named-mailboxes "Sent S"         "/home/nathan/.mail/school/[Gmail]/Sent Mail"
named-mailboxes "Drafts S"       "/home/nathan/.mail/school/[Gmail]/Drafts"
named-mailboxes "Trash S"        "/home/nathan/.mail/school/[Gmail]/Trash"


folder-hook /home/nathan/.mail/gmail/* \
    'source ~/.config/neomutt/gmail.muttrc'

folder-hook /home/nathan/.mail/school/* \
    'source ~/.config/neomutt/school.muttrc'

# Quick account switching

macro index,pager <F2> \
    '<sync-mailbox><enter-command>source ~/.config/neomutt/gmail.muttrc<enter><change-folder>/home/nathan/.mail/gmail/Inbox<enter>' \
    "Switch to Personal"

macro index,pager <F3> \
    '<sync-mailbox><enter-command>source ~/.config/neomutt/school.muttrc<enter><change-folder>/home/nathan/.mail/school/Inbox<enter>' \
    "Switch to School"

#Bindings

bind pager g noop
bind index g noop

bind pager i noop

bind pager j next-line
bind pager k previous-line
bind pager <down> next-line
bind pager <up> previous-line
bind pager J next-undeleted
bind pager K previous-undeleted
bind pager <enter> next-undeleted
bind pager gg top
bind pager G bottom
bind generic,pager d half-down
bind generic,pager u half-up

bind index d display-message
bind index gg first-entry
bind index G last-entry
bind index j next-entry
bind index k previous-entry
bind index J next-thread
bind index K previous-thread

bind index,pager c mail
bind index,pager C compose-to-sender
bind index,pager r reply
bind index,pager a group-reply
macro index,pager A "<pipe-message>abook --add-email-quiet<enter>" "Add to contacts"
macro index,pager V <pipe-message>urlscan<enter>
macro compose A "<enter-command> source $HOME/nathan_dotfiles/scripts/filepicker.sh|<enter>" "Attach with file manager"

set query_command = "abook --mutt-query %s"
#set pager_context = 3                # show 3 lines of context
set pager_stop                       # stop at end of message
set menu_scroll                      # scroll menu
set tilde
set wait_key = no		     # mutt won't ask "press key to continue"
set fast_reply
unset sig_dashes
unset markers
set charset = "utf-8"
set uncollapse_jump
set sort_re
set sort = reverse-threads
set sort_aux = last-date-received
# How we reply and quote emails.
set reply_regexp = "^(([Rr][Ee]?(\[[0-9]+\])?: *)?(\[[^]]+\] *)?)*"
set quote_regexp = "^( {0,4}[>|:#%]| {0,4}[a-z0-9]+[>|]+)+"
set send_charset = "utf-8:iso-8859-1:us-ascii"

set editor = "nvim"

color status green default
#set signature = "~/nathan_dotfiles/config/neomutt/signature"
