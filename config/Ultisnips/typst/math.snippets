global !p
def math():
    return vim.eval("v:lua.typst_in_math()") in (1, "1", True)
endglobal

snippet ff "Inline Math" wA
$${1}$`!p
if t[2] and t[2][0] not in [',', '.', '?', '-', ' ']:
    snip.rv = ' '
else:
    snip.rv = ''
`$2
endsnippet


snippet all "Open Math environment" A
$
$1
$
$0
endsnippet

snippet bb "bold" iA
*$1*$0
endsnippet


context "math()"
snippet '([A-Za-z])(\d)' "auto subscript" wrA
`!p snip.rv = match.group(1)`_`!p snip.rv = match.group(2)`
endsnippet

priority 1000
context "math()"
snippet '([A-Za-z])_(\d\d)' "auto subscript2" wrA
`!p snip.rv = match.group(1)`_(`!p snip.rv = match.group(2)`)
endsnippet

priority 1000
context "math()"
snippet "([a-zA-Z]|[\}\)\]\|']);" "Subscript" rA
`!p snip.rv = match.group(1)`_(${1:${VISUAL:}})$0
endsnippet


context "math()"
snippet vec "vector" 
arrow($1)$0
endsnippet

#context "math()"
snippet "([\w]|[\}\)\]\|'])'" "Superscript" rA
`!p snip.rv = match.group(1)`^${1:${VISUAL:}}$0
endsnippet

#context "math()"
snippet "([a-zA-Z]|[\}\)\]\|']);" "Subscript" rA
`!p snip.rv = match.group(1)`_${1:${VISUAL:}}$0
endsnippet



