set from = `echo -n $SCHOOL_EMAIL` 
set realname = "Nathan Kamgang"
set sendmail = "/usr/bin/msmtp -a school"
set folder = "~/.mail/school"
set spoolfile = "+Inbox"
unset record
set postponed = "+[Gmail]/Drafts"
set trash = "+[Gmail]/Trash"
set header_cache = "~/.cache/neomutt/university/headers"
set message_cache_dir = "~/.cache/neomutt/university/bodies"
